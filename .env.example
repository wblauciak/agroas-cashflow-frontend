# Lokalny development: token z ograniczonym Read+List, wygenerowany np. przez
#   az storage container generate-sas --account-name agroasdashdata \
#     --name agroas-cashflow-data --auth-mode login --as-user \
#     --permissions rl --https-only --expiry <+7 dni>
# User-delegation SAS wygasa max po 7 dniach - trzeba regenerowac.
# W produkcji dostep idzie przez Azure Function (Entra ID), nie przez ten mechanizm.
VITE_DATA_BASE_URL=https://agroasdashdata.blob.core.windows.net/agroas-cashflow-data
VITE_DATA_SAS=
